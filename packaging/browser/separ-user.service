# Separ live barrier, one per user (systemd user unit).
# Install: /usr/lib/systemd/user/separ-user.service, then: systemctl --global enable separ-user.service
# Each user's daemon picks a free port (--port 0) and records it in its work directory, where the
# browser host finds it; users of a shared server never collide.
[Unit]
Description=Separ live barrier for this user
After=default.target

[Service]
ExecStart=/usr/bin/separ serve --port 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
